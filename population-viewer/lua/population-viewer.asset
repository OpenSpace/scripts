-- Population Viewer: every place on Earth with 1,000+ people (GeoNames cities1000) as a
-- glass column at its location, as tall as its population.
-- Generated by population-viewer/generate.py from lua/population-viewer.asset; edit the
-- template and regenerate rather than editing the copy in build/.
--
-- Places are split into population bands (10M+, 1M to 10M, ...). Each band is one
-- merged model in Earth's body-fixed frame with its origin at Earth's center, so
-- 139,000 places are only 8 renderables. The glass look (translucent faces, brighter
-- edges) is in the models' own materials, not in override colors. "Show cities with N+"
-- fades in every band at or above N and fades out the rest.
--
-- Column scales (10x height and 2x width, ...) are separate pre-built models, since a
-- merged model can't be scaled about each column at runtime. Only the current scale's
-- models are in the scene: the scale actions replace the nodes with another scale's.
local earthAsset = asset.require("scene/solarsystem/planets/earth/globe")
local sunAsset = asset.require("scene/solarsystem/sun/transforms")


-- Filled in by generate.py ------------------------------------------------------------
-- Largest band first: { Key, Label, Lower, Range, Count, Largest,
--                       Models = { x<height factor> = file } }
local Bands = {
--[[BANDS]]
}
-- Equatorial and polar radii (m) of the ellipsoid the models were built on.
local ModelRadii = --[[RADII]]
-- Column height in meters per 1,000 people, at scale 1.
local MetersPer1000 = --[[METERS_PER_1000]]
-- Column width in meters, at scale 1.
local Width = --[[WIDTH]]
-- Column scales that have models, as height and width factors.
local Scales = --[[SCALES]]
-- Index in Scales of the scale loaded with the asset.
local DefaultScale = --[[DEFAULT_SCALE]]
----------------------------------------------------------------------------------------

local GuiPath = "/Population Viewer"
local Tag = "population_viewer"
local Prefix = "PopulationViewer"

-- Smallest population currently shown (0: none). Set by the Show/Hide actions.
local Minimum = { Id = "PopulationViewerMinimum", Name = "Population viewer minimum" }
-- Height factor of the current column scale (managed by the scale actions).
local Scale = { Id = "PopulationViewerScale", Name = "Population column scale" }

local MinimumUri = "UserProperties." .. Minimum.Id
local ScaleUri = "UserProperties." .. Scale.Id
local function nodeId(band) return Prefix .. "_" .. band.Key end
local function scaleKey(scale) return string.format("x%g", scale.Height) end
-- e.g. "10x height, 2 km wide"
local function scaleName(scale)
  return string.format("%gx height, %g km wide", scale.Height, Width * scale.Width / 1000)
end


-- Lua run by the actions: fades each band in or out to match the minimum population.
-- Actions run in the global scope, so the band list is baked into the string.
local Apply
do
  local entries = {}
  for _, band in ipairs(Bands) do
    table.insert(entries, string.format(
      "{ %q, %d }", "Scene." .. nodeId(band) .. ".Renderable", band.Lower
    ))
  end
  Apply = string.format([[
    local minimum = openspace.propertyValue(%q)
    for _, e in ipairs({ %s }) do
      local renderable, lower = e[1], e[2]
      if openspace.hasProperty(renderable .. ".Enabled") then
        if minimum > 0 and lower >= minimum then
          openspace.fadeIn(renderable)
        elseif openspace.propertyValue(renderable .. ".Enabled") then
          openspace.fadeOut(renderable)
        end
      end
    end
  ]], MinimumUri, table.concat(entries, ", "))
end


-- Scene graph nodes for one scale, one per band.
local function makeNodes(scale)
  local nodes = {}
  for _, band in ipairs(Bands) do
    table.insert(nodes, {
      Identifier = nodeId(band),
      -- No transform: the model's vertices are already in Earth's body-fixed frame.
      Parent = earthAsset.Earth.Identifier,
      Renderable = {
        Type = "RenderableModel",
        GeometryFile = asset.resource("models/" .. band.Models[scaleKey(scale)]),
        Enabled = false,
        EnableFaceCulling = false,
        PerformShading = false,
        LightSources = { sunAsset.LightSource },
        -- Colors and opacity come from the model's materials. Transparent models are
        -- drawn after the deferred pass so they blend with the globe and atmosphere.
        RenderBinMode = "PostDeferredTransparent"
      },
      Tag = { Tag },
      GUI = {
        Name = "Cities " .. band.Range,
        Path = GuiPath,
        Description = string.format(
          "%d places with %s people, largest %s. Each is a column %g km wide and " ..
          "%g m tall per 1,000 people (%s). Population data: GeoNames, CC BY 4.0.",
          band.Count, band.Range, band.Largest, Width * scale.Width / 1000,
          MetersPer1000 * scale.Height, scaleName(scale)
        ),
        Focusable = false
      }
    })
  end
  return nodes
end

-- Built now: `asset` (for asset.resource) is not available inside onInitialize.
local NodesByScale = {}
for i, scale in ipairs(Scales) do
  NodesByScale[i] = makeNodes(scale)
end

-- Lua source for a table of strings, numbers, booleans and tables (for action strings).
local function serialize(v)
  if type(v) == "table" then
    local items = {}
    for k, x in pairs(v) do
      local key = type(k) == "number" and "" or (k .. " = ")
      table.insert(items, key .. serialize(x))
    end
    return "{ " .. table.concat(items, ", ") .. " }"
  elseif type(v) == "string" then
    return string.format("%q", v)
  else
    return tostring(v)
  end
end


local Actions = {}
for _, band in ipairs(Bands) do
  table.insert(Actions, {
    Identifier = "os.populationviewer.Show" .. band.Key,
    Name = "Show cities with " .. band.Label .. " people",
    Command = string.format("openspace.setPropertyValueSingle(%q, %d)\n", MinimumUri, band.Lower)
      .. Apply,
    Documentation = string.format(
      "Shows every place with at least %s people as a glass column on Earth, as tall " ..
      "as its population, and hides smaller places", band.Label:sub(1, -2)
    ),
    GuiPath = GuiPath,
    IsLocal = false
  })
end
table.insert(Actions, {
  Identifier = "os.populationviewer.HideAll",
  Name = "Hide all cities",
  Command = string.format("openspace.setPropertyValueSingle(%q, 0)\n", MinimumUri) .. Apply,
  Documentation = "Fades out every population column",
  GuiPath = GuiPath,
  IsLocal = false
})
for i, scale in ipairs(Scales) do
  -- Replaces every node with the same node using this scale's models, then shows the
  -- bands the settings ask for. The new nodes start hidden, so they fade in.
  table.insert(Actions, {
    Identifier = "os.populationviewer.Scale" .. scaleKey(scale),
    -- Loading the new models stalls rendering for a moment, hence the warning.
    Name = string.format("Scale %gx (Locks Rendering)", scale.Height),
    Command = string.format([[
      if openspace.propertyValue(%q) == %f then return end
      openspace.setPropertyValueSingle(%q, %f)
      for _, node in ipairs(%s) do
        if openspace.hasSceneGraphNode(node.Identifier) then
          openspace.removeSceneGraphNode(node.Identifier)
        end
        openspace.addSceneGraphNode(node)
      end
    ]], ScaleUri, scale.Height, ScaleUri, scale.Height, serialize(NodesByScale[i])) .. Apply,
    Documentation = string.format(
      "Shows the population columns %g km wide and %g m tall per 1,000 people. " ..
      "Rendering pauses while the models for this scale load",
      Width * scale.Width / 1000, MetersPer1000 * scale.Height
    ),
    GuiPath = GuiPath .. "/Settings",
    IsLocal = false
  })
end

asset.onInitialize(function()
  -- The models' vertices are baked in Earth's frame for given radii; check them against
  -- the globe actually loaded (points on its equator and pole, in its own frame).
  local geo = openspace.navigation.localPositionFromGeo
  local earth = earthAsset.Earth.Identifier
  local equator, pole = geo(earth, 0, 0, 0)[1], geo(earth, 90, 0, 0)[3]
  if math.abs(equator - ModelRadii[1]) > 10 or math.abs(pole - ModelRadii[2]) > 10 then
    openspace.printWarning(string.format(
      "Population Viewer models were built for Earth radii %.0f / %.0f m but Earth is " ..
      "%.0f / %.0f m, so columns will float or sink. Regenerate with --radii %.0f %.0f",
      ModelRadii[1], ModelRadii[2], equator, pole, equator, pole
    ))
  end

  -- Settings start fresh on every load; a property left by an earlier load that failed
  -- halfway is reused rather than added twice.
  local function setting(id, type, name, description, value)
    if not openspace.hasProperty("UserProperties." .. id) then
      openspace.addCustomProperty(id, type, name, description)
    end
    openspace.setPropertyValueSingle("UserProperties." .. id, value)
  end
  setting(Minimum.Id, "DoubleProperty", Minimum.Name,
    "Smallest population shown by the Population Viewer (0: none). Set by its actions", 0)
  setting(Scale.Id, "DoubleProperty", Scale.Name,
    "Height factor of the population columns' current scale. Change it with the Scale " ..
    "actions", Scales[DefaultScale].Height)

  for _, node in ipairs(NodesByScale[DefaultScale]) do
    openspace.addSceneGraphNode(node)
  end
  for _, action in ipairs(Actions) do
    openspace.action.registerAction(action)
  end
end)

asset.onDeinitialize(function()
  for i = #Actions, 1, -1 do
    openspace.action.removeAction(Actions[i])
  end
  -- Whichever scale is loaded, its nodes have these identifiers.
  local nodes = NodesByScale[1]
  for i = #nodes, 1, -1 do
    if openspace.hasSceneGraphNode(nodes[i].Identifier) then
      openspace.removeSceneGraphNode(nodes[i].Identifier)
    end
  end
  openspace.removeCustomProperty(Scale.Id)
  openspace.removeCustomProperty(Minimum.Id)
end)


asset.meta = {
  Name = "Population Viewer",
  Description = [[Every place on Earth with 1,000+ people as a glass column at
    its location, as tall as its population, with taller (and somewhat wider) scales
    to see them from further away. Hidden by default; use the "Show cities with N+ people"
    actions. Population data: GeoNames (geonames.org), CC BY 4.0.]],
  Author = "OpenSpace Team",
  URL = "https://openspaceproject.com",
  License = "MIT license; population data GeoNames, CC BY 4.0 (see LICENSE.md)"
}
