  Parent = earth.Earth.Identifier,
  Renderable = {
    Type = "RenderableVectorField",
    Mode = "Sparse",
    VectorFieldScale = 8.0,
    Sparse = {
      FilePath = asset.resource("ezie_l3_20250523_001810_sva_v001_r001_80.csv")
    },
    Coloring = {
      ColorMode = "Magnitude";
      ColorMap = colormaps.Uniform.Viridis,
      FixedColor = { 1.0, 0.7, 0.5, 1.0 }
    },
    RenderBinMode = "PostDeferredTransparent"
  },
  GUI = {
    Name = "001810 SVA v001 r001 80km",
    Path = "/EZIE L3/20250523",
  }
}

local Node2 = {
  Identifier = "ezie_l3_20250523_001810_sva_v001_r001_110km",
  Parent = earth.Earth.Identifier,
  Renderable = {
    Type = "RenderableVectorField",
    Mode = "Sparse",
    VectorFieldScale = 8.0,
